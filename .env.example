# Copy to .env to override the defaults. No secrets are needed to run Re:Claim.

# docker-compose.yml: public port of the web container (deploy script sets 80).
WEB_PORT=8080

# Echo service (api/src/server.ts, api/src/app.ts). Defaults shown.
PORT=3000
HOST=0.0.0.0
DB_PATH=data/echo.db
LOG_LEVEL=info
