{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunDeployOnTheOneInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:<AWS_REGION>:<AWS_ACCOUNT_ID>:instance/i-0984268d1f9dbed77",
        "arn:aws:ssm:<AWS_REGION>::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadDeployResult",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
